
"""API tests for the timetable FastAPI application."""


def test_health_returns_both_services_healthy(client):
    response = client.get("/health")

    assert response.status_code == 200
    assert response.json()["postgres"] is True
    assert response.json()["redis"] is True


def test_list_classes_starts_empty(client):
    response = client.get("/classes")

    assert response.status_code == 200
    assert response.json()["count"] == 0
    assert response.json()["classes"] == []


def test_add_and_list_class(client, payload):
    created = client.post("/classes", json=payload)

    assert created.status_code == 201
    assert created.json()["subject"] == "DBMS"
    assert created.json()["start"] == "10:00"
    assert created.json()["end"] == "11:00"

    listed = client.get("/classes")

    assert listed.status_code == 200
    assert listed.json()["count"] == 1
    assert listed.json()["classes"][0]["batch"] == "CSE-3A"


def test_invalid_class_returns_400(client, payload):
    payload["day"] = "Sunday"

    response = client.post("/classes", json=payload)

    assert response.status_code == 400


def test_overlapping_class_returns_409(client, payload):
    first = client.post("/classes", json=payload)
    assert first.status_code == 201

    second_payload = {
        **payload,
        "start": "10:30",
        "end": "11:30",
        "subject": "Operating Systems",
    }

    response = client.post("/classes", json=second_payload)

    assert response.status_code == 409
    assert "clashes" in response.json()["detail"]


def test_dry_run_does_not_create_a_class(client, payload):
    response = client.post("/classes/check", json=payload)

    assert response.status_code == 200
    assert response.json()["ok"] is True

    listed = client.get("/classes")

    assert listed.json()["count"] == 0


def test_back_to_back_class_is_accepted(client, payload):
    assert client.post("/classes", json=payload).status_code == 201

    next_payload = {
        **payload,
        "start": "11:00",
        "end": "12:00",
        "subject": "Operating Systems",
    }

    response = client.post("/classes", json=next_payload)

    assert response.status_code == 201


def test_filter_classes_by_day(client, payload):
    client.post("/classes", json=payload)

    response = client.get("/classes?day=Monday")

    assert response.status_code == 200
    assert response.json()["count"] == 1


def test_invalid_day_filter_returns_400(client):
    response = client.get("/classes?day=Sunday")

    assert response.status_code == 400


def test_delete_class(client, payload):
    created = client.post("/classes", json=payload)
    class_id = created.json()["id"]

    response = client.delete(f"/classes/{class_id}")

    assert response.status_code == 200
    assert response.json()["deleted"]["id"] == class_id
    assert client.get("/classes").json()["count"] == 0


def test_delete_missing_class_returns_404(client):
    response = client.delete("/classes/999")

    assert response.status_code == 404


def test_timetable_endpoint(client, payload):
    client.post("/classes", json=payload)

    response = client.get("/timetable/batch/CSE-3A")

    assert response.status_code == 200
    assert response.json()["kind"] == "batch"
    assert response.json()["value"] == "CSE-3A"
    assert response.json()["total_classes"] == 1


def test_invalid_timetable_kind_returns_400(client):
    response = client.get("/timetable/subject/DBMS")

    assert response.status_code == 400


def test_missing_timetable_returns_404(client):
    response = client.get("/timetable/batch/UNKNOWN")

    assert response.status_code == 404


def test_free_slots_endpoint(client):
    response = client.get("/free/mon?minutes=60")

    assert response.status_code == 200
    assert response.json()["day"] == "mon"
    assert response.json()["minimum_minutes"] == 60
    assert response.json()["free"]


def test_free_slots_rejects_invalid_day(client):
    response = client.get("/free/sunday")

    assert response.status_code == 400


def test_free_slots_rejects_nonpositive_minutes(client):
    response = client.get("/free/mon?minutes=0")

    assert response.status_code == 400


def test_timetable_cache_is_used(client, payload):
    client.post("/classes", json=payload)

    first = client.get("/timetable/batch/CSE-3A")
    second = client.get("/timetable/batch/CSE-3A")

    assert first.status_code == 200
    assert first.json()["cached"] is False
    assert second.status_code == 200
    assert second.json()["cached"] is True


def test_add_class_invalidates_timetable_cache(client, payload):
    client.post("/classes", json=payload)
    client.get("/timetable/batch/CSE-3A")

    next_payload = {
        **payload,
        "start": "11:00",
        "end": "12:00",
        "subject": "Operating Systems",
    }
    client.post("/classes", json=next_payload)

    response = client.get("/timetable/batch/CSE-3A")

    assert response.status_code == 200
    assert response.json()["cached"] is False
    assert response.json()["total_classes"] == 2
